{
	"name": "tokenmaxxer",
	"version": "0.1.0",
	"description": "Self-hosted AI spend dashboard for Cursor and Claude Code teams.",
	"keywords": [
		"ai",
		"finops",
		"cursor",
		"anthropic",
		"claude-code",
		"dashboard",
		"cost-management"
	],
	"author": "Ratnesh Neema and tokenmaxxer contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/ratneshpkn/tokenmaxxer.git"
	},
	"bugs": {
		"url": "https://github.com/ratneshpkn/tokenmaxxer/issues"
	},
	"homepage": "https://github.com/ratneshpkn/tokenmaxxer#readme",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun --hot run server/index.ts",
		"build": "vite build",
		"start": "NODE_ENV=production bun run server/index.ts",
		"test": "bun test --preload ./server/tests/setup.ts",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"bootstrap": "bun run server/scripts/bootstrap-config.ts",
		"seed:demo": "bun run server/scripts/seed-demo.ts",
		"sync:anthropic": "bun run server/scripts/sync-anthropic.ts",
		"sync:cursor": "bun run server/scripts/sync-cursor.ts",
		"sync:github": "bun run server/scripts/sync-github.ts",
		"backfill": "bun run server/scripts/backfill.ts",
		"alerts:compute": "bun run server/scripts/compute-alerts.ts",
		"recommendations:compute": "bun run server/scripts/compute-recommendations.ts",
		"prs:files": "bun run server/scripts/sync-pr-files.ts",
		"prs:enrich": "bun run server/scripts/enrich-prs.ts",
		"slack:digest": "bun run server/scripts/slack-digest.ts",
		"reset-admin-password": "bun run server/scripts/reset-admin-password.ts"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/react-query": "^5.102.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.5",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.37.0",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"wouter": "^3.10.0",
		"zod": "^4.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "^8.2.2"
	}
}
