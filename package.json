{
	"name": "tokenmaxxer",
	"version": "0.1.0",
	"description": "Self-hosted AI spend dashboard for Cursor and Claude Code teams.",
	"keywords": [
		"ai",
		"finops",
		"cursor",
		"anthropic",
		"claude-code",
		"dashboard",
		"cost-management"
	],
	"author": "Ratnesh Neema and tokenmaxxer contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/ratneshpkn/tokenmaxxer.git"
	},
	"bugs": {
		"url": "https://github.com/ratneshpkn/tokenmaxxer/issues"
	},
	"homepage": "https://github.com/ratneshpkn/tokenmaxxer#readme",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot run server/index.ts",
		"build": "vite build",
		"start": "NODE_ENV=production bun run server/index.ts",
		"test": "bun test --preload ./server/tests/setup.ts",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"bootstrap": "bun run server/scripts/bootstrap-config.ts",
		"seed:demo": "bun run server/scripts/seed-demo.ts",
		"sync:anthropic": "bun run server/scripts/sync-anthropic.ts",
		"sync:cursor": "bun run server/scripts/sync-cursor.ts",
		"sync:github": "bun run server/scripts/sync-github.ts",
		"backfill": "bun run server/scripts/backfill.ts",
		"alerts:compute": "bun run server/scripts/compute-alerts.ts",
		"slack:digest": "bun run server/scripts/slack-digest.ts",
		"reset-admin-password": "bun run server/scripts/reset-admin-password.ts"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.7",
		"@radix-ui/react-label": "^2.1.3",
		"@radix-ui/react-popover": "^1.1.7",
		"@radix-ui/react-scroll-area": "^1.2.4",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-query": "^5.60.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"drizzle-orm": "^0.39.3",
		"drizzle-zod": "^0.7.0",
		"hono": "^4.6.14",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.16.0",
		"pg": "^8.16.3",
		"react": "^19.0.0",
		"react-day-picker": "^8.10.1",
		"react-dom": "^19.0.0",
		"recharts": "^2.15.2",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7",
		"wouter": "^3.3.5",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.3.13",
		"@types/node": "^20.19.27",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.7.0",
		"drizzle-kit": "^0.31.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.6.3",
		"vite": "^7.3.0"
	}
}
