# tokenmaxxer config
#
# In development/test, all values here are OPTIONAL (the app falls back to dev values).
# In production, DATABASE_URL, CONFIG_ENCRYPTION_KEY, and SESSION_SECRET are REQUIRED.
#
# After first boot, configure org settings via the in-app /setup wizard.
# .env values are imported into the encrypted app_config on first boot,
# then become a runtime fallback for one release before being dropped.

# --- Master encryption key (REQUIRED for production) ---
# 32-byte hex string (64 chars). Used to encrypt API keys stored in the DB.
# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# --- Database (REQUIRED; override if running Postgres elsewhere) ---
# DATABASE_URL=postgres://user:password@host:5432/db

# --- App ---
# SESSION_SECRET=  # REQUIRED for production (use a secure random string)
# BASE_URL=http://localhost:3003
# PORT=3003

# --- AI tooling keys (optional bootstrap; configurable in /setup) ---
# ANTHROPIC_ADMIN_API_KEY=
# CURSOR_ADMIN_API_KEY=

# --- Slack (optional) ---
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# --- Auth domain restriction (optional; configurable in /setup) ---
# ALLOWED_EMAIL_DOMAIN=

# --- Cron (default off in dev) ---
ENABLE_CRON=false
